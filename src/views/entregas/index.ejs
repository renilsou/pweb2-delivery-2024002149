<h1>Entregas</h1>

<p>
  <a class="botao" href="/entregas/nova">Nova Entrega</a>
</p>

<form class="filtro" method="GET" action="/entregas">
  <label for="status">Filtrar por status:</label>
  <select id="status" name="status">
    <option value="">Todos</option>
    <% statusLista.forEach((s) => { %>
      <option value="<%= s %>" <%= s === status ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button type="submit">Filtrar</button>
</form>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Descrição</th>
      <th>Origem</th>
      <th>Destino</th>
      <th>Status</th>
      <th>Motorista</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (entregas.length === 0) { %>
      <tr><td colspan="7">Nenhuma entrega encontrada.</td></tr>
    <% } %>
    <% entregas.forEach((entrega) => { %>
      <tr>
        <td><%= entrega.id %></td>
        <td><%= entrega.descricao %></td>
        <td><%= entrega.origem %></td>
        <td><%= entrega.destino %></td>
        <td><span class="badge <%= entrega.status %>"><%= entrega.status %></span></td>
        <td><%= nomes[entrega.motoristaId] || '—' %></td>
        <td><a href="/entregas/<%= entrega.id %>">Detalhes</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
